{
  "name": "navigator",
  "version": "6.13.0",
  "description": "Finish What You Start - Sessions that last, AI that learns, Features that ship. Context engineering + Theory of Mind + Knowledge Graph + Loop Mode + Task Mode. Features Project Knowledge Graph (unified search, experiential memory), unified workflow orchestration, auto-update on session start, ToM-based verification checkpoints, bilateral modeling, quality detection, enhanced context markers, and Loop Mode. 92% token reduction with proven strategies. Based on Riedl & Weidmann 2025 Human-AI Synergy research.",
  "author": {
    "name": "Aleks Petrov",
    "email": "aleks@example.com",
    "url": "https://github.com/alekspetrov"
  },
  "homepage": "https://github.com/alekspetrov/navigator",
  "repository": "https://github.com/alekspetrov/navigator",
  "license": "MIT",
  "keywords": [
    "documentation",
    "context-management",
    "token-optimization",
    "knowledge-management",
    "knowledge-graph",
    "experiential-memory",
    "productivity",
    "skills",
    "agents",
    "navigator",
    "natural-language",
    "theory-of-mind",
    "human-ai-synergy",
    "bilateral-modeling"
  ],
  "skills": [
    "./skills/nav-graph",
    "./skills/nav-workflow",
    "./skills/nav-features",
    "./skills/nav-simplify",
    "./skills/nav-onboard",
    "./skills/nav-init",
    "./skills/nav-start",
    "./skills/nav-stats",
    "./skills/nav-profile",
    "./skills/nav-diagnose",
    "./skills/nav-loop",
    "./skills/nav-sync-claude",
    "./skills/nav-upgrade",
    "./skills/nav-install-multi-claude",
    "./skills/nav-multi",
    "./skills/nav-marker",
    "./skills/nav-compact",
    "./skills/nav-task",
    "./skills/nav-sop",
    "./skills/nav-skill-creator",
    "./skills/nav-release",
    "./skills/plugin-slash-command",
    "./skills/product-design",
    "./skills/visual-regression",
    "./skills/frontend-component",
    "./skills/backend-endpoint",
    "./skills/database-migration",
    "./skills/backend-test",
    "./skills/frontend-test"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_session_start.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_pre_compact.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_post_compact.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_workflow_state.py\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/workflow_enforcer.py\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_read_guard.py\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/token_monitor.py\"; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_commit_reminder.py\"; fi",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_task_graph_sync.py\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_DIR\" ]; then python3 \"$CLAUDE_PLUGIN_DIR/hooks/nav_profile_sync.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
